!/SimOneAPI/lib/Win64/environment_check.py
!/SimOneAPI/lib/Win64/sitecustomize.py
!/SimOneAPI/lib/Win64/README_PYTHON_SETUP.md
!/SimOneAPI/lib/Win64/StartNEVCALL.bat
!/SimOneAPI/lib/Win64/KillNEVCALL.bat
!/SimOneAPI/lib/Win64/StartAPA.bat
!/SimOneAPI/lib/Win64/StopAPA.bat
!/SimOneAPI/lib/Win64/startLKA.bat
!/SimOneAPI/lib/Win64/KillLKA.bat

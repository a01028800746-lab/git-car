# This repository lives inside a full SimOne installation.
# Track only reviewed team sources; never bulk-upload vendor software or data.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/SimOneAPI/
/SimOneAPI/*
!/SimOneAPI/lib/
/SimOneAPI/lib/*
!/SimOneAPI/lib/Win64/
/SimOneAPI/lib/Win64/*

# Team algorithms, evaluation adapter, environment helpers and launchers.
!/SimOneAPI/lib/Win64/AutoDrive.py
!/SimOneAPI/lib/Win64/ParkingAPA.py
!/SimOneAPI/lib/Win64/TestDrive.py
